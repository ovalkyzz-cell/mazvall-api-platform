generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  role          String    @default("user")
  tier          String    @default("free")
  status        String    @default("active")
  planId        String?
  planExpiry    DateTime?
  requestsToday Int       @default(0)
  lastRequestReset DateTime @default(now())
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  apiKeys       ApiKey[]
  usageLogs     UsageLog[]
  tickets       Ticket[]
  ticketReplies TicketReply[]
  transactions  Transaction[]
  discounts     Discount[]
}

model Plan {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  price           Int
  requestsPerDay  Int
  requestsPerMin  Int
  requestsPerHour Int
  description     String
  features        String
  featureAccess   String    @default("all")
  popular         Boolean   @default(false)
  active          Boolean   @default(true)
  discountCode    String?
  discountType    String?   @default("percentage")
  discountValue   Int?
  discountMaxUses Int?
  discountUsedCount Int     @default(0)
  discountExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  coupons         Coupon[]
  transactions    Transaction[]
}

model Transaction {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan       @relation(fields: [planId], references: [id])
  amount          Int
  transactionId   String?
  qrUrl           String?
  paymentUrl      String?
  status          String     @default("pending")
  discountId      String?
  discount        Discount?  @relation(fields: [discountId], references: [id])
  paidAt          DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model ApiKey {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  active      Boolean   @default(true)
  rateLimit   Int       @default(100)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  usageLogs   UsageLog[]
}

model UsageLog {
  id           String   @id @default(cuid())
  apiKeyId     String
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String
  method       String
  status       Int
  responseTime Int
  ip           String?
  createdAt    DateTime @default(now())
}

model Ticket {
  id        String   @id @default(cuid())
  subject   String
  message   String
  status    String   @default("open")
  priority  String   @default("normal")
  category  String   @default("general")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  replies   TicketReply[]
}

model TicketReply {
  id        String   @id @default(cuid())
  message   String
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RateLimitConfig {
  id               String @id @default(cuid())
  tier             String @unique
  requestsPerMinute Int  @default(100)
  requestsPerHour   Int  @default(1000)
  requestsPerDay    Int  @default(10000)
  description      String?
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  planId        String?
  plan          Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  discountType  String   @default("percentage")
  discountValue Int
  maxUses       Int      @default(1)
  usedCount     Int      @default(0)
  active        Boolean  @default(true)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Discount {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  percentage  Int       @default(0)
  maxUses     Int       @default(100)
  usedCount   Int       @default(0)
  validFrom   DateTime  @default(now())
  validUntil  DateTime?
  active      Boolean   @default(true)
  createdBy   String
  creator     User      @relation(fields: [createdBy], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  transactions Transaction[]
}
